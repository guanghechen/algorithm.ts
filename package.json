{
  "name": "@algorithm.ts/root",
  "version": "0.0.0",
  "private": true,
  "author": {
    "name": "guanghechen",
    "url": "https://github.com/guanghechen/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guanghechen/algorithm.ts"
  },
  "homepage": "https://github.com/guanghechen/algorithm.ts",
  "type": "module",
  "scripts": {
    ":publish": "pnpm clean && pnpm build:production && pnpm test:coverage && changeset publish",
    ":publish:all": "pnpm -r exec npm version patch --no-git-tag-version && pnpm -r publish --no-git-checks",
    ":version": "changeset version",
    ":upgrade": "pnpm update -i && pnpm clean && pnpm format && pnpm build && pnpm test",
    "build": "cross-env NODE_ENV=production BUILD_SOURCEMAP=true pnpm -r run build",
    "build:production": "cross-env NODE_ENV=production BUILD_SOURCEMAP=false pnpm -r run build",
    "clean": "pnpm -r run clean && pnpm install",
    "format": "biome check --write .",
    "prepublishOnly": "pinst --disable",
    "postinstall": "is-ci || husky",
    "postpublish": "pinst --enable",
    "rebuild": "pnpm clean && pnpm build",
    "test": "pnpm -r run --if-present test",
    "test:coverage": "pnpm -r run --if-present test:coverage",
    "test:update": "pnpm -r run --if-present test:update",
    "version": "pnpm install && node script/sync-doc-link.mjs && git stage -u pnpm-lock.yaml packages/**/package.json packages/**/*.md",
    "lint": "biome check .",
    "test:dist": "node script/test-dist.mjs",
    "typecheck": "tsc --project tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@changesets/changelog-github": "0.6.0",
    "@changesets/cli": "2.30.0",
    "@guanghechen/reporter": "3.3.0",
    "@types/node": "25.5.0",
    "@vitest/coverage-v8": "4.1.0",
    "cross-env": "10.1.0",
    "husky": "9.1.7",
    "is-ci": "4.1.0",
    "lint-staged": "16.4.0",
    "pinst": "3.0.0",
    "rimraf": "6.1.3",
    "tsdown": "0.23.0",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,mts,cjs,cts,json,jsonc}": "biome check --write --no-errors-on-unmatched"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
